# YoRadio RGB Panel — .gitignore policy (see repo migration discussion)
# Политика: IDE/build локально; docs/test/tools/bg — never; data/src/ai — track.
# Policy: keep IDE/build local; never track docs/test/tools/bg; track data/src/ai.

# --- IDE, CI, build artifacts / IDE, сборка ---
.pio/
.vscode/
.cursor/
/.github/
.fontwork/
compile_commands.json

# --- Python caches / кэши Python ---
__pycache__/
*.pyc

# --- Archives / архивы ---
*.zip
*.7z
SPECTRUM*.md

# --- Repository root: whitelist files only / в корне — только явный список ---
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/NOTICE
!/platformio.ini
# S01 mixed Arduino + ESP-IDF project entry and native defaults.
# Generated sdkconfig.<env> stays ignored by the root whitelist above.
# Точка входа mixed-сборки и native defaults. Сгенерированный sdkconfig.<env> остаётся скрыт.
!/CMakeLists.txt
!/sdkconfig.defaults
# FATFS LFN/UTF-8 overlay for the ordinary 4848S040 Storage Owner build.
# Overlay FATFS LFN/UTF-8 для штатной сборки Storage Owner 4848S040.
!/sdkconfig.defaults.storage_owner
# ESP-IDF component lock for reproducible builds (Freeze §8).
# Lock компонентов ESP-IDF для воспроизводимой сборки (Freeze §8).
!/dependencies.lock
!/partitions.csv
!/minimal_spiffs.csv
!/partition_16MB_ota_spiffs.csv
!/partition_16MB_ota_largefs.csv
!/README.md
# Intermediate releases inside a major Beta. README keeps only Beta 3, 4, 5...
# Промежуточные релизы внутри крупной Beta. В README остаются только Beta 3, 4, 5...
!/CHANGE_LOG.md
!/readme_english.md
!/README_4848S040.md
!/README_4848S040_english.md
!/readme_ai_layer_eng.md
!/readme_ai_layer_rus.md
!/readme_ai_prompt_explained_eng.md
!/readme_ai_prompt_explained_rus.md
!/readme/
!/settings_ai.jpg
!/ai/
!/data/
!/src/
# LVGL screen design doc — must stay tracked / design-док экрана — не игнорировать
!/src/src/lvgl_ui/screens/scr_weather_layout_tree.md
# i18n docs — only the approved bilingual set is tracked / только принятый комплект
/src/src/i18n/**/*.md
!/src/src/i18n/LOCALIZATION.md
!/src/src/i18n/README.md
!/src/src/i18n/WORKFLOW.md
!/boards/
# RELEASE-FOUNDATION-C: public release binaries tree — tracked / публичный каталог релизных бинарников — трекается
!/build_bin/
# Optional OFL sample user fonts (not embedded, not LittleFS).
# Необязательные OFL-примеры пользовательских шрифтов (не в прошивке и не в LittleFS).
!/fonts/
/fonts/*
!/fonts/samples/
!/fonts/samples/**

# --- Local-only trees at repo root / только локально (якорь /) ---
/bg/
/bootlogo/
/docs/
/test/
/tools/
/simulator/
/old/
/panel_vendor_files/
/STAGE0_STEP1_ANALYSIS.md
# Local dummy art blob, not referenced by firmware / локальная заглушка обложки, прошивкой не используется
/data/logo/art_dummy.bin
